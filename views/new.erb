<div class="l--table">
  <form action="/memos" method="post">
    <div class="l--table-row">
      <input type="text" name="title" id="title" value="<%= @memo.title %>"/>
    </div>
    <div class="l--table-row">
      <textarea name="detail" id="detail"><%= @memo.detail %></textarea>
    </div>
    <div class="l--table-row">
      <input type="submit" value="保存" class="l--button"/>
    </div>
  </form>
</div>
