<div class="l--table">
  <form action="/memos/<%= h(@memo.id) %>" method="post">
    <div class="l--table-row">
      <input type="hidden" name="_method" id="_method" value="PATCH"/>
    </div>
    <div class="l--table-row">
      <input type="text" name="title" id="title" value="<%= h(@memo.title) %>"/>
    </div>
    <div class="l--table-row">
      <textarea name="detail" id="detail"><%= h(@memo.detail) %></textarea>
    </div>
    <div class="l--table-row">
      <input type="submit" value="変更" class="l--button"/>
    </div>
  </form>
</div>
